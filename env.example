# SAMPLE ONLY. Copy this to a file named .env and put your real values there:
#     cp env.example .env        (or run: python -m scripts.init_env)
# Never put real keys in this file, in code, or in a commit. Only .env holds them (it is git-ignored).
# A value of xxxx means "not set".

# ---------------------------------------------------------------- REQUIRED for live generation
# Gemini via Google AI Studio: https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=xxxx
# Comma-separated model names, tried in order if one is rate-limited. List yours with:
#     python -m scripts.list_models        Example: GEMINI_MODELS=model-a,model-b
GEMINI_MODELS=xxxx
# Tavily search: https://tavily.com  (free monthly credits)
TAVILY_API_KEY=xxxx

# ---------------------------------------------------------------- OPTIONAL
# Jina Reader key. Page fetching works without it, at a lower rate limit.
JINA_API_KEY=xxxx
# Composio API key (free account). Enables the live "does Composio manage this OAuth app?" check.
# Without it, guides say managed auth is "unknown".
COMPOSIO_API_KEY=xxxx
# Supabase, so live-generated guides survive redeploys. Set BOTH or neither.
SUPABASE_URL=xxxx
SUPABASE_SERVICE_KEY=xxxx

# ---------------------------------------------------------------- LIMITS (protect your free quota)
# New guides allowed per visitor IP per window, and the window length in seconds.
RATE_LIMIT_PER_IP=4
RATE_LIMIT_WINDOW_S=3600
# Hard cap on new guides per day across all visitors.
DAILY_GENERATION_CAP=60
# How many guides may be generated at the same time.
MAX_CONCURRENT_GENERATIONS=2
# Set true on Render/Heroku-style hosts so the visitor IP is read from X-Forwarded-For.
TRUST_PROXY=false

# ---------------------------------------------------------------- TUNING (defaults are fine)
# Pages read per app, and max characters kept from each page.
MAX_PAGES=4
MAX_CHARS_PER_PAGE=12000
# Timeouts in seconds: web requests, one model call, and the whole guide.
HTTP_TIMEOUT_S=20
LLM_TIMEOUT_S=120
TOTAL_TIMEOUT_S=170
# Max tokens the model may write per guide.
LLM_MAX_OUTPUT_TOKENS=12000
# Where guides are stored. Leave commented to use ./data
# DATA_DIR=./data
